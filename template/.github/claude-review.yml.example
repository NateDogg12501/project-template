# NOT an active workflow — this file has an ".example" suffix and lives
# outside .github/workflows/ on purpose, so it doesn't run or require a
# secret until you're ready. See STANDARDS.md's "Pre-merge" section.
#
# To enable automated Claude Code review on every PR:
#   1. In a Claude Code terminal, run: /install-github-app
#      (installs the Claude GitHub App + wires the ANTHROPIC_API_KEY secret)
#   2. Move this file to .github/workflows/claude-review.yml (drop the
#      ".example" suffix)
#   3. Confirm the ANTHROPIC_API_KEY repository secret exists
#      (Settings -> Secrets and variables -> Actions)
#
# Costs: GitHub Actions minutes (runs on your own runner) + Anthropic API
# tokens per review. See code.claude.com/docs/en/github-actions.
#
# For a security-specific pass instead of/alongside general review, see
# https://github.com/anthropics/claude-code-security-review — same pattern,
# separate Action.

name: Code Review
on:
  pull_request:
    types: [opened, synchronize]

jobs:
  review:
    runs-on: ubuntu-latest
    steps:
      - uses: anthropics/claude-code-action@v1
        with:
          anthropic_api_key: ${{ secrets.ANTHROPIC_API_KEY }}
          plugin_marketplaces: "https://github.com/anthropics/claude-code.git"
          plugins: "code-review@claude-code-plugins"
          prompt: "/code-review:code-review ${{ github.repository }}/pull/${{ github.event.pull_request.number }}"
