name: CI

on:
  pull_request:
  push:
    branches: [main]

jobs:
  claude-md:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Check CLAUDE.md placeholders are filled in
        run: |
          if grep -nE '\[(fill in|Expand:|Things|What|Bugs|Scope cuts|The 2-3)' CLAUDE.md; then
            echo "CLAUDE.md still has unfilled template placeholders (see matches above) — fill them in before merging." >&2
            exit 1
          fi
{% if needs_api %}

  backend:
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: backend
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: npm
          cache-dependency-path: backend/package-lock.json
      - run: npm ci
      # Plain `npm test`, not `--if-present`: the API capability ships tests,
      # so a package with no test script is a defect this job should catch,
      # not something it should skip past.
      - run: npm test
{% endif %}
{% if needs_ui %}

  frontend:
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: frontend
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: npm
          cache-dependency-path: frontend/package-lock.json
      - run: npm ci
      - run: npm test
{% endif %}
{% if needs_hosting %}

  terraform:
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: terraform
    steps:
      - uses: actions/checkout@v4
      - uses: hashicorp/setup-terraform@v3
      - run: terraform init -backend=false
      - run: terraform validate
      - run: terraform fmt -check
{% endif -%}
