terraform {
  required_version = ">= 1.5"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.0"
    }
  }
}

provider "aws" {
  region = var.aws_region
}

module "app" {
  source = "git::https://github.com/<you>/terraform-modules.git//modules/lambda-web-app?ref=v1.0.0"

  app_name   = "{{ project_slug }}"
  aws_region = var.aws_region
  source_dir = "${path.module}/../dist-lambda"

  ssm_secret_env_vars = {
    # APP_SECRET = "/{{ project_slug }}/app_secret"
  }

  environment_variables = {
    WEB_DIST = "/var/task/web"
{% if needs_datastore %}
    ITEMS_TABLE_NAME = module.table.table_name
{% endif %}
  }
}
{% if needs_datastore %}

module "table" {
  source = "git::https://github.com/<you>/terraform-modules.git//modules/dynamodb-single-table?ref=v1.0.0"

  table_name = "{{ project_slug }}-items"
  hash_key   = "id"

  attributes = [
    { name = "id", type = "S" },
  ]
}

resource "aws_iam_role_policy" "app_table_access" {
  name = "{{ project_slug }}-table-access"
  role = module.app.lambda_role_name

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect   = "Allow"
      Action   = ["dynamodb:GetItem", "dynamodb:PutItem", "dynamodb:DeleteItem", "dynamodb:Query", "dynamodb:Scan"]
      Resource = [module.table.table_arn, "${module.table.table_arn}/index/*"]
    }]
  })
}
{% endif %}
