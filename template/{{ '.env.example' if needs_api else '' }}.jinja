# Copied to .env by scripts/setup-worktree-env.js — see CLAUDE.md.
BACKEND_PORT=3000
{% if needs_datastore %}

# Read by the one client-construction module in backend/src/dynamodb.js.
# docker-compose.yml passes this to the backend container so it talks to the
# dynamodb-local service below by container name. Leaving it unset entirely —
# which is what every deployed Lambda does — is what makes the same code talk
# to real DynamoDB instead. See STANDARDS.md's "Structure".
AWS_ENDPOINT_URL_DYNAMODB=http://dynamodb-local:8000
DYNAMODB_PORT=8000
{% endif %}
