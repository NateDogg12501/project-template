import { GetCommand, PutCommand } from '@aws-sdk/lib-dynamodb'
import { beforeAll, expect, test } from 'vitest'

import { ddb } from '../../src/dynamodb.js'
import { ensureTableExists } from '../../src/init-table.js'

const TABLE_NAME = process.env.ITEMS_TABLE_NAME || '{{ project_slug }}-items'

// Real read/write against the actual dynamodb-local container — not a mock,
// so this fails the way production would if the client module regressed. The
// `datastore` CI job brings the container up before running this file; to run
// it by hand: `docker compose up -d --wait dynamodb-local`, then
// `AWS_ENDPOINT_URL_DYNAMODB=http://localhost:8000 npm run test:integration`.
beforeAll(async () => {
    await ensureTableExists()
})

test('writes and reads an item against the real table', async () => {
    const item = { id: 'integration-test-item', value: 'hello' }

    await ddb.send(new PutCommand({ TableName: TABLE_NAME, Item: item }))
    const { Item } = await ddb.send(new GetCommand({ TableName: TABLE_NAME, Key: { id: item.id } }))

    expect(Item).toEqual(item)
})
