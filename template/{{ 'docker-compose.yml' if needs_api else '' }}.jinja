services:
  backend:
    build: ./backend
    ports:
      - "${BACKEND_PORT:-3000}:3000"
{% if needs_ui %}
    volumes:
      - ./frontend:/app/frontend
{% endif %}
    environment:
      - PORT=3000
{% if needs_datastore %}
      - AWS_ENDPOINT_URL_DYNAMODB=${AWS_ENDPOINT_URL_DYNAMODB:-http://dynamodb-local:8000}
      - ITEMS_TABLE_NAME={{ project_slug }}-items
    depends_on:
      dynamodb-local:
        # Not the default `service_started` — without this, backend races
        # dynamodb-local on a cold `compose up` and index.js's
        # ensureTableExists() intermittently hits a port nothing is
        # listening on yet. That's the worst kind of failure to debug because
        # it only shows up sometimes.
        condition: service_healthy
{% endif %}
{% if needs_datastore %}

  # DynamoDB Local, not LocalStack — see docs/decisions.md. -inMemory means a
  # fresh `compose up` always starts empty; backend/src/init-table.js (run on
  # boot) recreates the same key schema terraform/main.tf declares for real
  # AWS, so there's no separate seed step and nothing to gitignore.
  dynamodb-local:
    image: amazon/dynamodb-local:latest
    command: "-jar DynamoDBLocal.jar -inMemory -sharedDb"
    ports:
      - "${DYNAMODB_PORT:-8000}:8000"
    healthcheck:
      # No `-f`: DynamoDB Local returns HTTP 400 for a bare GET (it only
      # implements the DynamoDB POST API), and `curl -f` treats any 4xx as
      # failure — that healthcheck would never pass. Reaching the port at all
      # is the signal; verified against the real image before relying on it.
      test: ["CMD-SHELL", "curl -s -o /dev/null http://localhost:8000/ || exit 1"]
      interval: 2s
      timeout: 2s
      retries: 15
{% endif %}
