terraform {
  # >= 1.10 for `use_lockfile` in backend.tf — S3-native state locking, so no
  # DynamoDB lock table.
  required_version = ">= 1.10"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.0"
    }
  }
}

provider "aws" {
  region = var.aws_region
}

# Composed here, not in terraform-modules: the modules take app_name/table_name
# as plain strings, so per-environment naming belongs to the root config that
# knows the environment, not to a module that doesn't.
locals {
  name_prefix = "{{ project_slug }}-${var.environment}"
}

module "app" {
  source = "git::https://github.com/NateDogg12501/terraform-modules.git//modules/lambda-web-app?ref=v2.1.0"

  app_name   = local.name_prefix
  aws_region = var.aws_region
  source_dir = "${path.module}/../dist-lambda"

  # The deploy pipeline's `ensure-secrets` stage creates
  # /{{ project_slug }}/<environment>/session_secret before this applies, and
  # leaves it alone on every deploy after the first. Uncomment to hand it to
  # the Lambda — but note that a by-hand `terraform apply` has not run that
  # stage, so create the parameter yourself first (terraform/README.md) or the
  # plan fails on a parameter that isn't there.
  ssm_secret_env_vars = {
    # SESSION_SECRET = "/{{ project_slug }}/${var.environment}/session_secret"
  }

  # The `=` padding is capability-dependent because `terraform fmt -check` is
  # a CI step: HCL aligns `=` across a block, so WEB_DIST's spacing depends on
  # whether ITEMS_TABLE_NAME is beside it. Generating the unaligned version
  # made every DATABASE project fail its own terraform job on the first push.
  environment_variables = {
{% if needs_ui %}
{% if needs_datastore %}
    WEB_DIST         = "/var/task/web"
{% else %}
    WEB_DIST = "/var/task/web"
{% endif %}
{% endif %}
{% if needs_datastore %}
    ITEMS_TABLE_NAME = module.table.table_name
{% endif %}
  }
}
{% if needs_datastore %}

module "table" {
  source = "git::https://github.com/NateDogg12501/terraform-modules.git//modules/dynamodb-single-table?ref=v2.1.0"

  table_name = "${local.name_prefix}-items"
  hash_key   = "id"

  attributes = [
    { name = "id", type = "S" },
  ]

  # The module defaults to 5/5, which is wrong for this pipeline rather than
  # wrong in general. DynamoDB's always-free allowance is 25 read and 25 write
  # units for the whole account and region, and the capacity gate refuses to
  # deploy past 20 of them. At 5/5 a project costs 10 units across its two
  # environments, so the third hosted project with a datastore takes the
  # account over the gate — and because the gate sums tables that already
  # exist, it is not that project's deploy that fails, it is every deploy
  # after it, in every project. 1/1 is enough for anything this template is
  # for; a project that outgrows it should say so here, deliberately.
  read_capacity  = 1
  write_capacity = 1
}

resource "aws_iam_role_policy" "app_table_access" {
  name = "${local.name_prefix}-table-access"
  role = module.app.lambda_role_name

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect   = "Allow"
      Action   = ["dynamodb:GetItem", "dynamodb:PutItem", "dynamodb:DeleteItem", "dynamodb:Query", "dynamodb:Scan"]
      Resource = [module.table.table_arn, "${module.table.table_arn}/index/*"]
    }]
  })
}
{% endif %}
